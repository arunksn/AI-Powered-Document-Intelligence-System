# Shared configuration for the backend, Celery worker, and frontend.
# Copy to .env in the repository root. Never commit real credentials.
# On Vercel, configure these as project environment variables.

# Application and authentication
# Use ENV=production and strong random secrets for production.
ENV=development
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_EXPIRE_MINUTES=10080

# Backend and worker must share the same PostgreSQL and Redis resources.
# SQLite is for local development only. Docker Compose overrides these URLs
# with its internal postgres/redis hostnames. On Vercel, use external URLs.
DATABASE_URL=sqlite:///./docintel.db
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=/tmp/docintel_uploads

# Public frontend origin; used for CORS and CRM links.
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# OCR and document analysis
OCR_CONFIDENCE_THRESHOLD=60.0
OCR_LANGUAGES=eng
MIN_TERMINATION_NOTICE_DAYS=15
MAX_PAYMENT_TERMS_DAYS=90
YOY_CHANGE_THRESHOLD_PCT=35.0
INDUSTRY_RATIO_RANGES_JSON='{"debt_to_assets":[0.0,0.85],"net_margin":[-0.25,0.50]}'

# CRM integration: notion or airtable; credentials are optional.
CRM_PROVIDER=notion
NOTION_API_KEY=
NOTION_DATABASE_ID=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Documents

# Worker and model memory
# The Vercel worker command explicitly fixes concurrency at 1.
CELERY_CONCURRENCY=1
MODEL_IDLE_UNLOAD_SECONDS=120
MAX_CONCURRENT_MODELS=1

# Frontend: leave these unset for Vercel Services and local Vite development.
# Only VITE_ variables are exposed to the browser. Never put secrets in them.
# Set only when hosting the backend separately; omit /api and /ws suffixes.
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com

# Optional local Vite proxy target; Docker Compose overrides this to web:8000.
# API_PROXY_TARGET=http://localhost:8000
